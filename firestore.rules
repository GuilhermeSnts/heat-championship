rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: check if the requester is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: check if the authenticated user is an admin
    // Looks up the user document in the 'users' collection
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ============ players collection ============
    match /players/{playerId} {
      // Anyone can read players
      allow read: if true;

      // Only admins can create/update/delete
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============ races collection ============
    match /races/{raceId} {
      // Anyone can read races
      allow read: if true;

      // Only admins can create/update/delete
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============ users collection ============
    match /users/{userId} {
      // Users can read their own document, admins can read all
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      // Only admins can write to users collection
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
